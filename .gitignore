# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Database files
*.db
*.sqlite
*.sqlite3

# Real config files hold passwords/API keys and NetMon rewrites config.yaml at
# runtime, so they are never tracked. Templates: config.example.yaml,
# stripe_config.example.yaml (copied automatically on first run).
/config.yaml
/stripe_config.yaml
/data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Secrets -- never commit (the license private key, per-install auth secret)
license_signing_key.pem
*.pem
*.key
auth_secret.key
